# Obtain both values from the same local or staging project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public support mailbox (server configuration; published when valid).
AURA_SUPPORT_EMAIL=
# Enable only after the public-only database views pass the release checks.
AURA_PUBLIC_PROJECTIONS_ENABLED=false

# Canonical application origin used in provider callbacks.
AURA_SITE_URL=http://127.0.0.1:3101
AURA_SMS_ENABLED=false

# Optional server-only M07 configuration. Use an approved HTTPS chat completions endpoint.
AURA_AI_ENDPOINT=
AURA_AI_API_KEY=
AURA_AI_MODEL=
